{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/perguntas-frequentes",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/cidade/sao-jose-dos-pinhais",
      "destination": "/cidade/so-jos-dos-pinhais",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pvsdecore.com.br"
        }
      ],
      "destination": "https://www.pvsdecore.com.br/:path*",
      "permanent": true
    }
  ]
}
